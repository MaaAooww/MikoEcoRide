Options -Indexes
DirectoryIndex index.php

RewriteEngine On
RewriteBase /EcoRide/public/

# Si le fichier/dossier existe physiquement, on le sert directement
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Sinon, on envoie tout vers index.php (front controller)
RewriteRule ^ index.php [L]
